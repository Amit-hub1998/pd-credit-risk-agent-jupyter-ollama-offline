// ---------------------------------------------------------------------------
// Helper: standard "icon-circle + title + subtitle (+optional sub2)" card
// ---------------------------------------------------------------------------
function drawCard({ x, y, w, h, iconText, iconBg, title, subtitle, sub2, sub2Color, sub2Bold }) {
  slide.addShape(pres.shapes.RECTANGLE, {
    x, y, w, h,
    fill: { color: "FFFFFF" }, line: { color: C.navy, width: 1.25 },
  });

  const iconSize = 0.55;
  const iconX = x + 0.18;
  const iconY = y + (h - iconSize) / 2;
  slide.addShape(pres.shapes.OVAL, {
    x: iconX, y: iconY, w: iconSize, h: iconSize,
    fill: { color: iconBg }, line: { color: iconBg, width: 0 },
  });
  slide.addText(iconText, {
    x: iconX, y: iconY, w: iconSize, h: iconSize,
    fontFace: "Calibri", fontSize: 11, bold: true, color: "FFFFFF",
    align: "center", valign: "middle", margin: 0,
  });

  const tx = iconX + iconSize + 0.18;
  const tw = x + w - tx - 0.15;
  slide.addText(title, {
    x: tx, y: y + 0.08, w: tw, h: 0.32,
    fontFace: "Calibri", fontSize: 14, bold: true, color: C.navy,
    align: "left", valign: "middle", margin: 0,
  });
  slide.addText(subtitle, {
    x: tx, y: y + 0.38, w: tw, h: 0.28,
    fontFace: "Calibri", fontSize: 11, color: C.bodyText,
    align: "left", valign: "middle", margin: 0,
  });
  if (sub2) {
    slide.addText(sub2, {
      x: tx, y: y + 0.62, w: tw, h: 0.24,
      fontFace: "Calibri", fontSize: 10, italic: true,
      bold: !!sub2Bold,
      color: sub2Color || C.muted,
      align: "left", valign: "middle", margin: 0,
    });
  }
}

